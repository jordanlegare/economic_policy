# Install as /etc/cad-policy-studio/backend.env with mode 0600.
# The server refuses --bind-all unless this token is at least 16 characters.
CAD_POLICY_STUDIO_TOKEN=replace-with-a-long-random-production-token

# Per-process in-memory session working set. With the supplied 16-process pool,
# 8192 entries/process provides about 131k cache slots before idle eviction.
CAD_SESSION_CACHE_SIZE=8192
